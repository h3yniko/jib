{
  "name": "deployjib",
  "version": "0.0.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/h3yniko/jib"
  },
  "bin": {
    "jib": "dist/jib.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsup --entry.jib src/main.ts --format esm --platform node --target node22 --external better-sqlite3 --clean --no-splitting && chmod +x dist/jib.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && npm run fmt:check",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "dev": "tsx src/main.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "better-sqlite3": "^12.11.1",
    "consola": "^3.2.3",
    "drizzle-orm": "^0.45.2",
    "yaml": "^2.8.3",
    "yargs": "^18.0.0",
    "zod": "^3.23.8",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.0",
    "@types/yargs": "^17.0.35",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
